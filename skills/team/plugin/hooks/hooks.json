{
  "description": "Record teammate state events for /team status (no tool input, no secrets).",
  "hooks": {
    "SessionStart": [{"matcher": "", "hooks": [{"type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/event.sh\" SessionStart", "timeout": 5}]}],
    "UserPromptSubmit": [{"hooks": [{"type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/event.sh\" UserPromptSubmit", "timeout": 5}]}],
    "PreToolUse": [{"matcher": "", "hooks": [{"type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/event.sh\" PreToolUse", "timeout": 5}]}],
    "PostToolUse": [{"matcher": "", "hooks": [{"type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/event.sh\" PostToolUse", "timeout": 5}]}],
    "PostToolUseFailure": [{"matcher": "", "hooks": [{"type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/event.sh\" PostToolUseFailure", "timeout": 5}]}],
    "PermissionRequest": [{"matcher": "", "hooks": [{"type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/event.sh\" PermissionRequest", "timeout": 5}]}],
    "PermissionDenied": [{"matcher": "", "hooks": [{"type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/event.sh\" PermissionDenied", "timeout": 5}]}],
    "Notification": [{"matcher": "", "hooks": [{"type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/event.sh\" Notification", "timeout": 5}]}],
    "Stop": [{"hooks": [{"type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/event.sh\" Stop", "timeout": 5}]}],
    "StopFailure": [{"hooks": [{"type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/event.sh\" StopFailure", "timeout": 5}]}],
    "SubagentStart": [{"matcher": "", "hooks": [{"type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/event.sh\" SubagentStart", "timeout": 5}]}],
    "SubagentStop": [{"matcher": "", "hooks": [{"type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/event.sh\" SubagentStop", "timeout": 5}]}],
    "SessionEnd": [{"matcher": "", "hooks": [{"type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/event.sh\" SessionEnd", "timeout": 5}]}]
  }
}
